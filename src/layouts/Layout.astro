---
import "../styles/global.css";

const siteUrl = import.meta.env.SITE;
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
---

<!doctype html>
<html lang="ja" data-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/flag.svg" />
		<link rel="manifest" href="/manifest.json" />
		<meta name="theme-color" content="#1f2937" />
		<meta name="generator" content={Astro.generator} />
		<title>マインスイーパーWeb</title>
		
		<!-- SEO -->
		<meta name="description" content="クラシックなマインスイーパーゲーム。マウス操作・タッチ操作の両方に対応したブラウザで遊べるマインスイーパー。" />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:title" content="マインスイーパーWeb" />
		<meta property="og:description" content="クラシックなマインスイーパーゲーム。マウス操作・タッチ操作の両方に対応したブラウザで遊べるマインスイーパー。" />
		
		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={pageUrl} />
		<meta property="twitter:title" content="マインスイーパーWeb" />
		<meta property="twitter:description" content="クラシックなマインスイーパーゲーム。マウス操作・タッチ操作の両方に対応したブラウザで遊べるマインスイーパー。" />
		
		<!-- Additional -->
    <link rel="canonical" href={pageUrl} />
		
		<!-- Preload game SVG assets -->
		<link rel="preload" href="/closed.svg" as="image" type="image/svg+xml" />
		<link rel="preload" href="/flag.svg" as="image" type="image/svg+xml" />
		<link rel="preload" href="/mine.svg" as="image" type="image/svg+xml" />
		<link rel="preload" href="/mine_red.svg" as="image" type="image/svg+xml" />
		<link rel="preload" href="/mine_wrong.svg" as="image" type="image/svg+xml" />
		<link rel="preload" href="/type0.svg" as="image" type="image/svg+xml" />
	</head>
	<body>
		<slot />
	</body>
</html>
