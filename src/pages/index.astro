---
import Layout from "../layouts/Layout.astro";
import Demo from "../components/Demo.tsx";
import "../styles/game.css";
import { DIFFICULTY_PRESETS } from "../components/game/constants.ts";
---

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=left_click,mouse,pinch,right_click,touch_app,touch_long" />
<style>
.description > * {
  margin-top: 4rem;
}

.description > *:last-child {
  margin-top: none;
}

.title:before,
.title:after {
  content: "";
  display: inline-block;

  background-size: contain;
  vertical-align: text-top;

  width: 1em;
  height: 1em;
}
.title:before {
  background-image: url('/flag.svg');
  margin-right: 0.25em;
}
.title:after {
  background-image: url('/mine.svg');
  margin-left: 0.25em;
}
</style>

<Layout>
  <article class="min-h-screen flex flex-col items-center p-4 bg-gradient-to-br from-base-300 to-base-100">
    <section class="text-center space-y-12 max-w">

      <div class="hero min-h-[50svh] justify-center">
        <div class="hero-content text-center flex-col gap-8">

          <h1 class="title font-bold text-2xl sm:text-4xl">マインスイーパー</h1>

          <p class="text-base sm:text-lg md:text-xl text-base-content/80 max-w-md mx-auto px-4">
            クラシックなマインスイーパーゲーム<br />
            マウス操作・タッチ操作の両方に対応
          </p>

          <a
            href="/play"
            class="btn btn-neutral btn-wide btn-secondary"
          >
            ゲームを始める
          </a>

        </div>
      </div>

    </section>

    <section class="description">
      <article class="flex flex-col items-center justify-center gap-2">
        <h2 class="text-accent rounded mb-2">
          セルを開く
        </h2>
        <p class="flex items-center gap-2">
          <span class="material-symbols-outlined">left_click</span>
          左クリック&nbsp;
          または&nbsp;
          <span class="material-symbols-outlined">touch_app</span>
          タップ
        </p>
        <Demo client:only />
      </article>
      <article class="flex flex-col items-center justify-center gap-2">
        <h2 class="text-accent rounded mb-2 inline-flex items-center justify-center gap-1">
          <img src="/flag.svg" alt="旗" class="w-5 h-5 inline-block" loading="lazy" />
          の設置
        </h2>
        <p class="flex items-center gap-2">
          <span class="material-symbols-outlined">right_click</span>
          右クリック&nbsp;
          または&nbsp;
          <span class="material-symbols-outlined">touch_long</span>
          長押し
        </p>
        <Demo client:only />
      </article>
    </section>

  </article>
</Layout>
