---
import Layout from "../layouts/Layout.astro";
import Game from "../components/Game.tsx";
---
<style>
.material-symbols-outlined {
  font-variation-settings:
  'FILL' 1,
  'wght' 300,
  'GRAD' 0,
  'opsz' 20
}
</style>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=settings" />
<Layout>
  <div id="game-root"></div>
</Layout>

<script>
  import Game from "../components/Game.tsx";
  import { createRoot } from "react-dom/client";
  import { createElement } from "react";

  const params = new URLSearchParams(window.location.search);
  const seed = params.get("seed");
  const r = params.get("r");
  const c = params.get("c");
  const rows = params.get("rows");
  const cols = params.get("cols");
  const mines = params.get("mines");

  const gameConfig = {
    seed: seed ? Number.parseInt(seed) : undefined,
    startPosition:
      r && c ? { r: Number.parseInt(r), c: Number.parseInt(c) } : undefined,
    resetSeedOnReset: false,
    ...(rows && cols && mines
      ? {
          rows: Number.parseInt(rows),
          cols: Number.parseInt(cols),
          mines: Number.parseInt(mines),
        }
      : {}),
  };

  const rootElement = document.getElementById("game-root");
  if (rootElement) {
    const root = createRoot(rootElement);
    root.render(createElement(Game, { gameConfig }));
  }
</script>
