---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
---

<Layout title="Licenses - Mine Sweeper">
	<main>
		<h1>Licenses</h1>
		
		<section>
			<h2>DSEG Font Family</h2>
			<p>
				This project uses the <strong>DSEG Font Family (v0.46)</strong> by keshikan,
				which is licensed under the SIL Open Font License, Version 1.1.
			</p>
			<p>
				DSEG is a free font which imitates LCD Display (7SEG, 14SEG, Weather icons etc.).
			</p>
			<ul>
				<li>Author: keshikan</li>
				<li>License: <a href="https://scripts.sil.org/OFL" target="_blank" rel="noopener noreferrer">SIL OPEN FONT LICENSE Version 1.1</a></li>
				<li>Source: <a href="https://github.com/keshikan/DSEG" target="_blank" rel="noopener noreferrer">https://github.com/keshikan/DSEG</a></li>
				<li>Website: <a href="https://www.keshikan.net/fonts-e.html" target="_blank" rel="noopener noreferrer">https://www.keshikan.net/fonts-e.html</a></li>
			</ul>
		</section>
	</main>
</Layout>

<style>
	main {
		max-width: 800px;
		margin: 0 auto;
		padding: 2rem;
	}

	h1 {
		font-size: 2rem;
		margin-bottom: 2rem;
	}

	section {
		margin-bottom: 2rem;
	}

	h2 {
		font-size: 1.5rem;
		margin-bottom: 1rem;
	}

	p {
		margin-bottom: 1rem;
		line-height: 1.6;
	}

	ul {
		list-style: disc;
		margin-left: 2rem;
		line-height: 1.8;
	}

	a {
		color: #0066cc;
		text-decoration: underline;
	}

	a:hover {
		color: #0052a3;
	}
</style>
